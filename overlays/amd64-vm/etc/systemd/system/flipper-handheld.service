# Handheld mode: a sway kiosk on tty1 whose only client is flipctl, at whole-pixel
# scale. sway rather than cage because sway scales an output by an integer with
# nearest-neighbour filtering, which is what keeps the 256x144 panel crisp.
#
# Started by flipper-boot-mode.sh; stopped by anything that starts desktop mode,
# which is how Ctrl+Alt+D in flipper-kbd-bridge switches over without a reboot.
[Unit]
Description=Flipper One handheld mode (flipctl in a sway kiosk on tty1)
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service flipper-mcu-mock.service
Wants=flipper-kbd-bridge.service
Conflicts=getty@tty1.service sddm.service flipctl-headless.service flipper-desktop.target

[Service]
Type=simple
User=user
# A real login session on tty1, so logind hands sway seat0's DRM and input devices.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
# A VM's GPU is emulated, when there is one at all: render in software and draw the
# cursor in the frame. Software rendering of a 256x144 surface costs nothing.
Environment=WLR_RENDERER=pixman
Environment=WLR_NO_HARDWARE_CURSORS=1
ExecStart=/usr/bin/sway --config /etc/flipper/sway-handheld.conf
Restart=always
RestartSec=2
